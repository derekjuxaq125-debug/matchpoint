# Copie este archivo como .env.local y ponga los datos de SU proyecto de Supabase
# (Supabase > Project Settings > API). La llave "anon"/"publishable" es pública por diseño:
# la seguridad está en las funciones RPC y en RLS, no en ocultar esta llave.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
